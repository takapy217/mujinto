            "result": {
              "result_image": {"type": "video","file": "8-4.mp4","autoplay": true,"muted": true,"loop": false,"controls": false},
              "text": "金属音の正体は鉄鍋を背負った巨大ヤドカリ。驚き転んでダメージを受ける。このあと、光のほうへ進むことにした。",
              "lp": 0,
              "next": "52"
            }
          }
